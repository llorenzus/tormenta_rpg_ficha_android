{
  "expo": {
    "name": "Fichas Tormenta RPG",
    "slug": "ficha-tormenta-rpg",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B1E1E"
    },
    "android": {
      "package": "com.tormenta.ficha",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B1E1E"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
